# Fudan credentials
StuId=your_student_id
UISPsw=your_password

# Course IDs to monitor (comma-separated)
COURSE_IDS=12345,67890

# ModelScope access token (the project keeps the historical env-var name)
DASHSCOPE_API_KEY=ms-your_modelscope_token

# Required handwritten-board transcription.
# Default whitelist is only 泛函分析; comma-separate additional course-title
# fragments only if you deliberately want board extraction for more courses.
BLACKBOARD_COURSES=泛函分析

# Dense video sampling remains every 15s for completeness. A local temporal
# selector reduces these samples before any paid/remote vision request.
BLACKBOARD_SAMPLE_SEC=15
# Keep at least one stable representative frame per minute across the lecture.
BLACKBOARD_COVERAGE_SEC=60
# Extra frames are selected when a visual change persists into the next sample.
BLACKBOARD_CHANGE_THRESHOLD=24
BLACKBOARD_STABLE_THRESHOLD=14
BLACKBOARD_CHANGE_RATIO=0.008
BLACKBOARD_EVENT_GAP_SEC=30
BLACKBOARD_ANALYSIS_WIDTH=192

# Smaller batches are more reliable with the currently verified ModelScope
# endpoint. Missing frame blocks are retried individually.
BLACKBOARD_VISION_BATCH_SIZE=4
BLACKBOARD_VISION_MODELS=Qwen/Qwen3-VL-8B-Instruct
BLACKBOARD_VISION_MAX_TOKENS=4096

# Soft cap for very long lectures. Coverage anchors are preserved first, then
# the strongest persistent-change events. For a 2.5h lecture this normally
# means <=240 vision frames rather than ~600 raw samples.
BLACKBOARD_MAX_FRAMES=240
BLACKBOARD_FFMPEG_TIMEOUT=1800

# QQ SMTP (use authorization code, not login password)
SMTP_EMAIL=your_qq@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
RECEIVER_EMAIL=receiver@example.com

# Storage (optional, defaults shown)
DATA_DIR=data
DB_PATH=data/icourse.db

# SenseVoice model (optional, defaults shown)
SENSEVOICE_MODEL_DIR=sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
SILERO_VAD_PATH=silero_vad.onnx
